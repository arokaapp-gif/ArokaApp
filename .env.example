# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Auth Configuration (Email + Password, No SMS/Phone login)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# PostgreSQL & PostGIS Database
DATABASE_URL="postgresql://aroka_user:password@localhost:5432/aroka_production?sslmode=require"

# Redis Cache & BullMQ Background Queues
REDIS_URL="redis://localhost:6379"

# S3-Compatible Object Storage & CDN
STORAGE_ACCESS_KEY=""
STORAGE_SECRET=""
STORAGE_BUCKET="aroka-production-assets"
CDN_URL="https://cdn.arokaapp.in"

# Compliant Indian Payment Gateway (Double-entry Ledger Source)
PAYMENT_KEY_ID=""
PAYMENT_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# Aroka AI Gateway Abstraction Layer
AI_API_KEY=""

# Telephony & Voice Care Gateway (Official line: 8249892208)
VOICE_PROVIDER_SECRET=""
OFFICIAL_CUSTOMER_CARE_NUMBER="8249892208"

# Telegram Assistant Bot (ArokaAppBot)
TELEGRAM_BOT_TOKEN=""

# Security & Sessions
JWT_SECRET=""

